<Application x:Class="AiDaBenYing.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Material Design 基础（保留以获取 PackIcon 等控件） -->
                <materialDesign:BundledTheme BaseTheme="Dark" PrimaryColor="DeepPurple" SecondaryColor="Cyan" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
                <!-- Neumorphism 深色主题（初始加载） -->
                <ResourceDictionary Source="NeumorphismDark.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 全局默认按钮样式覆盖：阻断 MaterialDesign 的 Button 隐式样式（RaisedButton），
                 避免给 Neumorphism 按钮叠加 Material 风格的 Padding / 边框 / 阴影。 -->
            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
