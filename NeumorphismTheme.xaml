<!--
  NeumorphismTheme.xaml
  ======================
  深色 Neumorphism（Soft Dark）风格资源字典。

  核心设计原则：
  - 背景色：#2A2A38（柔和高对比度深灰蓝）
  - 亮阴影（光源方向：左上，135°）：#3A3A4C（比背景浅，模拟凸起）
  - 暗阴影（右下，315°）：#1E1E28（比背景深，模拟凹陷）
  - 圆角：12-16px（柔和边缘，无硬边框）
  - 强调色：#8B5CF6（紫罗兰主色） + #06B6D4（青色辅助）
  - 所有交互态通过阴影翻转实现真实触感
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════
         1. NEUMORPHISM 颜色系统
         ═══════════════════════════════════════════════════════════════ -->

    <!-- 主背景色：所有元素的基色 -->
    <Color x:Key="NeuroBackground">#2A2A38</Color>
    <SolidColorBrush x:Key="NeuroBackgroundBrush" Color="{StaticResource NeuroBackground}"/>

    <!-- 亮阴影（光源方向：左上） -->
    <Color x:Key="NeuroLightShadow">#3A3A4C</Color>
    <SolidColorBrush x:Key="NeuroLightShadowBrush" Color="{StaticResource NeuroLightShadow}"/>

    <!-- 暗阴影（凹陷方向：右下） -->
    <Color x:Key="NeuroDarkShadow">#1E1E28</Color>
    <SolidColorBrush x:Key="NeuroDarkShadowBrush" Color="{StaticResource NeuroDarkShadow}"/>

    <!-- 主强调色：紫罗兰 -->
    <Color x:Key="NeuroAccent">#8B5CF6</Color>
    <SolidColorBrush x:Key="NeuroAccentBrush" Color="{StaticResource NeuroAccent}"/>

    <!-- 辅助强调色：青色 -->
    <Color x:Key="NeuroAccent2">#06B6D4</Color>
    <SolidColorBrush x:Key="NeuroAccent2Brush" Color="{StaticResource NeuroAccent2}"/>

    <!-- 主要文本 -->
    <Color x:Key="NeuroText">#C4C4D4</Color>
    <SolidColorBrush x:Key="NeuroTextBrush" Color="{StaticResource NeuroText}"/>

    <!-- 次要文本 -->
    <Color x:Key="NeuroTextDim">#8888A0</Color>
    <SolidColorBrush x:Key="NeuroTextDimBrush" Color="{StaticResource NeuroTextDim}"/>

    <!-- 高亮/选中背景 -->
    <Color x:Key="NeuroHighlight">#353548</Color>
    <SolidColorBrush x:Key="NeuroHighlightBrush" Color="{StaticResource NeuroHighlight}"/>

    <!-- 按下态内阴影背景 -->
    <Color x:Key="NeuroInset">#222230</Color>
    <SolidColorBrush x:Key="NeuroInsetBrush" Color="{StaticResource NeuroInset}"/>

    <!-- 边框（用于过渡效果） -->
    <Color x:Key="NeuroBorder">#3E3E50</Color>
    <SolidColorBrush x:Key="NeuroBorderBrush" Color="{StaticResource NeuroBorder}"/>

    <!-- 错误/危险色 -->
    <Color x:Key="NeuroDanger">#EF4444</Color>
    <SolidColorBrush x:Key="NeuroDangerBrush" Color="{StaticResource NeuroDanger}"/>

    <!-- 成功色 -->
    <Color x:Key="NeuroSuccess">#22C55E</Color>
    <SolidColorBrush x:Key="NeuroSuccessBrush" Color="{StaticResource NeuroSuccess}"/>

    <!-- 警告色 -->
    <Color x:Key="NeuroWarning">#F59E0B</Color>
    <SolidColorBrush x:Key="NeuroWarningBrush" Color="{StaticResource NeuroWarning}"/>

    <!-- ═══════════════════════════════════════════════════════════════
         2. NEUMORPHISM 按钮样式
         ═══════════════════════════════════════════════════════════════ -->

    <!-- 标准 Neumorphism 按钮（凸起态） -->
    <Style x:Key="NeuroButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource NeuroBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource NeuroTextBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="20,12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- 外层容器提供 Neumorphic 凸起阴影 -->
                    <Grid>
                        <!-- 左上亮阴影（光源） -->
                        <Border x:Name="LightShadowBorder"
                                CornerRadius="14"
                                Background="{StaticResource NeuroBackgroundBrush}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10"
                                                  ShadowDepth="6"
                                                  Direction="315"
                                                  Color="#3A3A4C"
                                                  Opacity="0.75"/>
                            </Border.Effect>
                        </Border>

                        <!-- 右下暗阴影 -->
                        <Border x:Name="DarkShadowBorder"
                                CornerRadius="14"
                                Background="{StaticResource NeuroBackgroundBrush}"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10"
                                                  ShadowDepth="6"
                                                  Direction="135"
                                                  Color="#1E1E28"
                                                  Opacity="0.9"/>
                            </Border.Effect>
                        </Border>

                        <!-- 内容层 -->
                        <Border x:Name="ContentBorder"
                                CornerRadius="14"
                                Background="{StaticResource NeuroBackgroundBrush}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- 鼠标悬停：轻微提升阴影 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="LightShadowBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="14"
                                                      ShadowDepth="8"
                                                      Direction="315"
                                                      Color="#3A3A4C"
                                                      Opacity="0.85"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="DarkShadowBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="14"
                                                      ShadowDepth="8"
                                                      Direction="135"
                                                      Color="#1E1E28"
                                                      Opacity="0.95"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="{StaticResource NeuroAccentBrush}"/>
                        </Trigger>

                        <!-- 按下态：阴影翻转（内陷效果） -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="LightShadowBorder" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="DarkShadowBorder" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="ContentBorder" Property="Background" Value="{StaticResource NeuroInsetBrush}"/>
                            <Setter TargetName="ContentBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="6"
                                                      ShadowDepth="2"
                                                      Direction="135"
                                                      Color="#1E1E28"
                                                      Opacity="0.6"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="{StaticResource NeuroAccentBrush}"/>
                        </Trigger>

                        <!-- 禁用态 -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 主按钮（强调色） -->
    <Style x:Key="NeuroPrimaryButton" TargetType="Button" BasedOn="{StaticResource NeuroButton}">
        <Setter Property="Foreground" Value="{StaticResource NeuroAccentBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- 亮阴影 -->
                        <Border x:Name="LightShadowBorder"
                                CornerRadius="14"
                                Background="{StaticResource NeuroBackgroundBrush}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12"
                                                  ShadowDepth="6"
                                                  Direction="315"
                                                  Color="#3A3A4C"
                                                  Opacity="0.8"/>
                            </Border.Effect>
                        </Border>

                        <!-- 暗阴影 -->
                        <Border x:Name="DarkShadowBorder"
                                CornerRadius="14"
                                Background="{StaticResource NeuroBackgroundBrush}"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12"
                                                  ShadowDepth="6"
                                                  Direction="135"
                                                  Color="#1E1E28"
                                                  Opacity="0.9"/>
                            </Border.Effect>
                        </Border>

                        <!-- 强调色内容 -->
                        <Border x:Name="ContentBorder"
                                CornerRadius="14"
                                Background="{StaticResource NeuroBackgroundBrush}">
                            <Grid>
                                <Border CornerRadius="14"
                                        BorderBrush="{StaticResource NeuroAccentBrush}"
                                        BorderThickness="1.5"
                                        Opacity="0.6"/>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ContentBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="18"
                                                      ShadowDepth="0"
                                                      Direction="0"
                                                      Color="#8B5CF6"
                                                      Opacity="0.25"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="#A78BFA"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="LightShadowBorder" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="DarkShadowBorder" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="ContentBorder" Property="Background" Value="{StaticResource NeuroInsetBrush}"/>
                            <Setter Property="Foreground" Value="#8B5CF6"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 危险/删除按钮 -->
    <Style x:Key="NeuroDangerButton" TargetType="Button" BasedOn="{StaticResource NeuroButton}">
        <Setter Property="Foreground" Value="{StaticResource NeuroDangerBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="LightShadowBorder" CornerRadius="14">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="6" Direction="315" Color="#3A3A4C" Opacity="0.75"/>
                            </Border.Effect>
                            <Border.Background>
                                <SolidColorBrush Color="#2A2A38"/>
                            </Border.Background>
                        </Border>
                        <Border x:Name="DarkShadowBorder" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="6" Direction="135" Color="#1E1E28" Opacity="0.9"/>
                            </Border.Effect>
                            <Border.Background>
                                <SolidColorBrush Color="#2A2A38"/>
                            </Border.Background>
                        </Border>
                        <Border x:Name="ContentBorder" CornerRadius="14">
                            <Border.Background>
                                <SolidColorBrush Color="#2A2A38"/>
                            </Border.Background>
                            <Grid>
                                <Border CornerRadius="14" BorderBrush="#EF4444" BorderThickness="1.5" Opacity="0.6"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ContentBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="0" Direction="0" Color="#EF4444" Opacity="0.25"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="LightShadowBorder" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="DarkShadowBorder" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="ContentBorder" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="#222230"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 扁平文字按钮（无阴影，悬停时轻微抬起） -->
    <Style x:Key="NeuroFlatButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource NeuroTextBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource NeuroHighlightBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource NeuroAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource NeuroInsetBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 图标按钮（圆形/方形小按钮） -->
    <Style x:Key="NeuroIconButton" TargetType="Button">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Background" Value="{StaticResource NeuroBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource NeuroTextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="LightShadowBorder" CornerRadius="12"
                                Background="{StaticResource NeuroBackgroundBrush}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="4" Direction="315" Color="#3A3A4C" Opacity="0.7"/>
                            </Border.Effect>
                        </Border>
                        <Border x:Name="DarkShadowBorder" CornerRadius="12"
                                Background="{StaticResource NeuroBackgroundBrush}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="4" Direction="135" Color="#1E1E28" Opacity="0.85"/>
                            </Border.Effect>
                        </Border>
                        <Border x:Name="ContentBorder" CornerRadius="12"
                                Background="{StaticResource NeuroBackgroundBrush}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource NeuroAccentBrush}"/>
                            <Setter TargetName="ContentBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="0" Direction="0" Color="#8B5CF6" Opacity="0.2"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="LightShadowBorder" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="DarkShadowBorder" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="ContentBorder" Property="Background" Value="{StaticResource NeuroInsetBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         3. NEUMORPHISM 输入框样式
         ═══════════════════════════════════════════════════════════════ -->

    <!-- 标准文本输入框（凹陷态） -->
    <Style x:Key="NeuroTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource NeuroBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource NeuroTextBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource NeuroAccentBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <!-- 内阴影容器 -->
                        <Border x:Name="OuterBorder"
                                CornerRadius="12"
                                Background="{StaticResource NeuroBackgroundBrush}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6"
                                                  ShadowDepth="2"
                                                  Direction="135"
                                                  Color="#1E1E28"
                                                  Opacity="0.7"/>
                            </Border.Effect>
                        </Border>
                        <!-- 内高光边缘 -->
                        <Border x:Name="InnerHighlight"
                                CornerRadius="12"
                                BorderBrush="#3A3A4C"
                                BorderThickness="1"
                                Opacity="0.3"/>
                        <!-- 内容容器 -->
                        <Border x:Name="ContentBorder"
                                CornerRadius="12"
                                Padding="2,0">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="InnerHighlight" Property="BorderBrush" Value="{StaticResource NeuroAccentBrush}"/>
                            <Setter TargetName="InnerHighlight" Property="Opacity" Value="0.8"/>
                            <Setter TargetName="OuterBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="8"
                                                      ShadowDepth="0"
                                                      Direction="0"
                                                      Color="#8B5CF6"
                                                      Opacity="0.2"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="InnerHighlight" Property="BorderBrush" Value="{StaticResource NeuroBorderBrush}"/>
                            <Setter TargetName="InnerHighlight" Property="Opacity" Value="0.7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         4. NEUMORPHISM 卡片样式
         ═══════════════════════════════════════════════════════════════ -->

    <!-- 通用凸起卡片 -->
    <Style x:Key="NeuroCard" TargetType="Border">
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Background" Value="{StaticResource NeuroBackgroundBrush}"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="12"
                                  ShadowDepth="6"
                                  Direction="315"
                                  Color="#3A3A4C"
                                  Opacity="0.65"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 凹陷面板（用于输入区域、代码区等） -->
    <Style x:Key="NeuroInsetPanel" TargetType="Border">
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Background" Value="{StaticResource NeuroInsetBrush}"/>
        <Setter Property="BorderBrush" Value="#3A3A4C"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Opacity" Value="0.6"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         5. NEUMORPHISM 列表/选择项样式
         ═══════════════════════════════════════════════════════════════ -->

    <!-- 列表项容器（凹陷态列表） -->
    <Style x:Key="NeuroListItemContainer" TargetType="Border">
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Background" Value="{StaticResource NeuroBackgroundBrush}"/>
        <Setter Property="Margin" Value="0,4"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         6. NEUMORPHISM 单选按钮（用于颜色/图标选择器）
         ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="NeuroChipRadio" TargetType="RadioButton">
        <Setter Property="Background" Value="{StaticResource NeuroBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource NeuroTextBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="LightShadowBorder" CornerRadius="10">
                            <Border.Background>
                                <SolidColorBrush Color="#2A2A38"/>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="4" Direction="315" Color="#3A3A4C" Opacity="0.7"/>
                            </Border.Effect>
                        </Border>
                        <Border x:Name="DarkShadowBorder" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <SolidColorBrush Color="#2A2A38"/>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="4" Direction="135" Color="#1E1E28" Opacity="0.85"/>
                            </Border.Effect>
                        </Border>
                        <Border x:Name="ContentBorder" CornerRadius="10"
                                Background="{StaticResource NeuroBackgroundBrush}"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Ellipse x:Name="check"
                                         Width="8" Height="8"
                                         Fill="{StaticResource NeuroAccentBrush}"
                                         Margin="0,0,8,0"
                                         Visibility="Collapsed"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="ContentBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="0" Direction="0" Color="#8B5CF6" Opacity="0.35"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="{StaticResource NeuroAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource NeuroAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         7. NEUMORPHISM 应用卡片模板（用于 App 列表）
         ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="NeuroAppCard" TargetType="Button">
        <Setter Property="Margin" Value="8"/>
        <Setter Property="MinWidth" Value="200"/>
        <Setter Property="MinHeight" Value="70"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="Background" Value="{StaticResource NeuroBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource NeuroTextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- 亮阴影 -->
                        <Border x:Name="LightShadowBorder"
                                CornerRadius="16"
                                Background="{StaticResource NeuroBackgroundBrush}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10"
                                                  ShadowDepth="5"
                                                  Direction="315"
                                                  Color="#3A3A4C"
                                                  Opacity="0.7"/>
                            </Border.Effect>
                        </Border>
                        <!-- 暗阴影 -->
                        <Border x:Name="DarkShadowBorder"
                                CornerRadius="16"
                                Background="{StaticResource NeuroBackgroundBrush}"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10"
                                                  ShadowDepth="5"
                                                  Direction="135"
                                                  Color="#1E1E28"
                                                  Opacity="0.85"/>
                            </Border.Effect>
                        </Border>
                        <!-- 内容 -->
                        <Border x:Name="ContentBorder"
                                CornerRadius="16"
                                Background="{StaticResource NeuroBackgroundBrush}">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="LightShadowBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="14"
                                                      ShadowDepth="7"
                                                      Direction="315"
                                                      Color="#3A3A4C"
                                                      Opacity="0.8"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="DarkShadowBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="14"
                                                      ShadowDepth="7"
                                                      Direction="135"
                                                      Color="#1E1E28"
                                                      Opacity="0.95"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="{StaticResource NeuroAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="LightShadowBorder" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="DarkShadowBorder" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="ContentBorder" Property="Background" Value="{StaticResource NeuroInsetBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
