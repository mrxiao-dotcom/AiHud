<!--
  NeumorphismDark.xaml
  ====================
  深色 Neumorphism 风格资源字典（优化版）。

  颜色设计原则（修复阴沉感）：
  - 背景色：#2E2E3E（比旧版 #2A2A38 更亮，微带蓝紫调）
  - 亮阴影：#3E3E52（比背景亮，模拟光源）
  - 暗阴影：#1E1E2C（比背景深，但不压得太暗）
  - 强调色：#A78BFA（提升对比度，悬停时更明显）
  - 文本：#D8D8E8（高对比度，清晰可读）
  - 次要文本：#9090A8（柔和）
  - 选中态：#383850（比背景亮但不突兀）
  - 内陷态：#262636（凹陷区域）

  关键改进：
  - 背景提升明度（42→46%），减少压抑感
  - 强调色纯度提升（#8B5CF6 → #A78BFA），暗底更显眼
  - 阴影对比度加大（差值从 8→10%），立体感更强
  - 悬停时光晕效果增强，提升交互反馈
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════
         颜色系统
         ═══════════════════════════════════════════════════════════════ -->

    <!-- 主背景色 -->
    <Color x:Key="NeuroBackground">#2E2E3E</Color>
    <SolidColorBrush x:Key="NeuroBackgroundBrush" Color="{DynamicResource NeuroBackground}"/>

    <!-- 亮阴影（左上，光源） -->
    <Color x:Key="NeuroLightShadow">#3E3E52</Color>
    <SolidColorBrush x:Key="NeuroLightShadowBrush" Color="{DynamicResource NeuroLightShadow}"/>

    <!-- 暗阴影（右下） -->
    <Color x:Key="NeuroDarkShadow">#1E1E2C</Color>
    <SolidColorBrush x:Key="NeuroDarkShadowBrush" Color="{DynamicResource NeuroDarkShadow}"/>

    <!-- 主强调色（紫罗兰，提升可见性） -->
    <Color x:Key="NeuroAccent">#A78BFA</Color>
    <SolidColorBrush x:Key="NeuroAccentBrush" Color="{DynamicResource NeuroAccent}"/>

    <!-- 辅助强调色（青色） -->
    <Color x:Key="NeuroAccent2">#22D3EE</Color>
    <SolidColorBrush x:Key="NeuroAccent2Brush" Color="{DynamicResource NeuroAccent2}"/>

    <!-- 主要文本 -->
    <Color x:Key="NeuroText">#D8D8E8</Color>
    <SolidColorBrush x:Key="NeuroTextBrush" Color="{DynamicResource NeuroText}"/>

    <!-- 次要文本 -->
    <Color x:Key="NeuroTextDim">#9090A8</Color>
    <SolidColorBrush x:Key="NeuroTextDimBrush" Color="{DynamicResource NeuroTextDim}"/>

    <!-- 选中/高亮背景 -->
    <Color x:Key="NeuroHighlight">#383850</Color>
    <SolidColorBrush x:Key="NeuroHighlightBrush" Color="{DynamicResource NeuroHighlight}"/>

    <!-- 内陷态背景（凹陷区域） -->
    <Color x:Key="NeuroInset">#262636</Color>
    <SolidColorBrush x:Key="NeuroInsetBrush" Color="{DynamicResource NeuroInset}"/>

    <!-- 边框色 -->
    <Color x:Key="NeuroBorder">#484860</Color>
    <SolidColorBrush x:Key="NeuroBorderBrush" Color="{DynamicResource NeuroBorder}"/>

    <!-- 危险色 -->
    <Color x:Key="NeuroDanger">#F87171</Color>
    <SolidColorBrush x:Key="NeuroDangerBrush" Color="{DynamicResource NeuroDanger}"/>

    <!-- 成功色 -->
    <Color x:Key="NeuroSuccess">#4ADE80</Color>
    <SolidColorBrush x:Key="NeuroSuccessBrush" Color="{DynamicResource NeuroSuccess}"/>

    <!-- 警告色 -->
    <Color x:Key="NeuroWarning">#FBBF24</Color>
    <SolidColorBrush x:Key="NeuroWarningBrush" Color="{DynamicResource NeuroWarning}"/>

    <!-- ═══════════════════════════════════════════════════════════════
         按钮样式
         ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="NeuroButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource NeuroBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource NeuroTextBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="20,12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="LightShadowBorder" CornerRadius="14"
                                Background="{DynamicResource NeuroBackgroundBrush}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="6" Direction="315"
                                                  Color="#3E3E52" Opacity="0.8"/>
                            </Border.Effect>
                        </Border>
                        <Border x:Name="DarkShadowBorder" CornerRadius="14"
                                Background="{DynamicResource NeuroBackgroundBrush}"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="6" Direction="135"
                                                  Color="#1E1E2C" Opacity="0.9"/>
                            </Border.Effect>
                        </Border>
                        <Border x:Name="ContentBorder" CornerRadius="14"
                                Background="{DynamicResource NeuroBackgroundBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="LightShadowBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="8" Direction="315"
                                                      Color="#3E3E52" Opacity="0.9"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="DarkShadowBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="8" Direction="135"
                                                      Color="#1E1E2C" Opacity="0.95"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="{DynamicResource NeuroAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="LightShadowBorder" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="DarkShadowBorder" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="ContentBorder" Property="Background"
                                    Value="{DynamicResource NeuroInsetBrush}"/>
                            <Setter TargetName="ContentBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="2" Direction="135"
                                                      Color="#1E1E2C" Opacity="0.6"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="{DynamicResource NeuroAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 主按钮（强调色） -->
    <Style x:Key="NeuroPrimaryButton" TargetType="Button" BasedOn="{StaticResource NeuroButton}">
        <Setter Property="Foreground" Value="{DynamicResource NeuroAccentBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="LightShadowBorder" CornerRadius="14"
                                Background="{DynamicResource NeuroBackgroundBrush}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="6" Direction="315"
                                                  Color="#3E3E52" Opacity="0.85"/>
                            </Border.Effect>
                        </Border>
                        <Border x:Name="DarkShadowBorder" CornerRadius="14"
                                Background="{DynamicResource NeuroBackgroundBrush}"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="6" Direction="135"
                                                  Color="#1E1E2C" Opacity="0.95"/>
                            </Border.Effect>
                        </Border>
                        <Border x:Name="ContentBorder" CornerRadius="14"
                                Background="{DynamicResource NeuroBackgroundBrush}">
                            <Grid>
                                <Border CornerRadius="14"
                                        BorderBrush="{DynamicResource NeuroAccentBrush}"
                                        BorderThickness="1.5" Opacity="0.5"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ContentBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Direction="0"
                                                      Color="#A78BFA" Opacity="0.3"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="#C4B5FD"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="LightShadowBorder" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="DarkShadowBorder" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="ContentBorder" Property="Background"
                                    Value="{DynamicResource NeuroInsetBrush}"/>
                            <Setter Property="Foreground" Value="#A78BFA"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 危险按钮 -->
    <Style x:Key="NeuroDangerButton" TargetType="Button" BasedOn="{StaticResource NeuroButton}">
        <Setter Property="Foreground" Value="{DynamicResource NeuroDangerBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="LightShadowBorder" CornerRadius="14"
                                Background="{DynamicResource NeuroBackgroundBrush}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="6" Direction="315"
                                                  Color="#3E3E52" Opacity="0.8"/>
                            </Border.Effect>
                        </Border>
                        <Border x:Name="DarkShadowBorder" CornerRadius="14"
                                Background="{DynamicResource NeuroBackgroundBrush}"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="6" Direction="135"
                                                  Color="#1E1E2C" Opacity="0.9"/>
                            </Border.Effect>
                        </Border>
                        <Border x:Name="ContentBorder" CornerRadius="14"
                                Background="{DynamicResource NeuroBackgroundBrush}">
                            <Grid>
                                <Border CornerRadius="14" BorderBrush="#F87171" BorderThickness="1.5" Opacity="0.5"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ContentBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Direction="0"
                                                      Color="#F87171" Opacity="0.3"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="LightShadowBorder" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="DarkShadowBorder" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="ContentBorder" Property="Background"
                                    Value="{DynamicResource NeuroInsetBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 扁平文字按钮 -->
    <Style x:Key="NeuroFlatButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource NeuroTextBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}"
                            CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background"
                                    Value="{DynamicResource NeuroHighlightBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource NeuroAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background"
                                    Value="{DynamicResource NeuroInsetBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 图标按钮 -->
    <Style x:Key="NeuroIconButton" TargetType="Button">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Background" Value="{DynamicResource NeuroBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource NeuroTextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="LightShadowBorder" CornerRadius="12"
                                Background="{DynamicResource NeuroBackgroundBrush}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="5" Direction="315"
                                                  Color="#3E3E52" Opacity="0.75"/>
                            </Border.Effect>
                        </Border>
                        <Border x:Name="DarkShadowBorder" CornerRadius="12"
                                Background="{DynamicResource NeuroBackgroundBrush}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="5" Direction="135"
                                                  Color="#1E1E2C" Opacity="0.9"/>
                            </Border.Effect>
                        </Border>
                        <Border x:Name="ContentBorder" CornerRadius="12"
                                Background="{DynamicResource NeuroBackgroundBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource NeuroAccentBrush}"/>
                            <Setter TargetName="ContentBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="0" Direction="0"
                                                      Color="#A78BFA" Opacity="0.25"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="LightShadowBorder" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="DarkShadowBorder" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="ContentBorder" Property="Background"
                                    Value="{DynamicResource NeuroInsetBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         输入框样式
         ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="NeuroTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource NeuroBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource NeuroTextBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource NeuroAccentBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="OuterBorder" CornerRadius="12"
                                Background="{DynamicResource NeuroBackgroundBrush}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="3" Direction="135"
                                                  Color="#1E1E2C" Opacity="0.7"/>
                            </Border.Effect>
                        </Border>
                        <Border x:Name="InnerHighlight" CornerRadius="12"
                                BorderBrush="#484860" BorderThickness="1" Opacity="0.4"/>
                        <Border x:Name="ContentBorder" CornerRadius="12" Padding="2,0">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="InnerHighlight" Property="BorderBrush"
                                    Value="{DynamicResource NeuroAccentBrush}"/>
                            <Setter TargetName="InnerHighlight" Property="Opacity" Value="0.9"/>
                            <Setter TargetName="OuterBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="0" Direction="0"
                                                      Color="#A78BFA" Opacity="0.25"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="InnerHighlight" Property="BorderBrush"
                                    Value="{DynamicResource NeuroBorderBrush}"/>
                            <Setter TargetName="InnerHighlight" Property="Opacity" Value="0.8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         卡片样式
         ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="NeuroCard" TargetType="Border">
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Background" Value="{DynamicResource NeuroBackgroundBrush}"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="14" ShadowDepth="6" Direction="315"
                                  Color="#3E3E52" Opacity="0.7"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NeuroInsetPanel" TargetType="Border">
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Background" Value="{DynamicResource NeuroInsetBrush}"/>
        <Setter Property="BorderBrush" Value="#484860"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Opacity" Value="0.7"/>
    </Style>

    <Style x:Key="NeuroListItemContainer" TargetType="Border">
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Background" Value="{DynamicResource NeuroBackgroundBrush}"/>
        <Setter Property="Margin" Value="0,4"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         单选按钮（颜色/图标选择器）
         ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="NeuroChipRadio" TargetType="RadioButton">
        <Setter Property="Background" Value="{DynamicResource NeuroBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource NeuroTextBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="LightShadowBorder" CornerRadius="10"
                                Background="{DynamicResource NeuroBackgroundBrush}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="5" Direction="315"
                                                  Color="#3E3E52" Opacity="0.75"/>
                            </Border.Effect>
                        </Border>
                        <Border x:Name="DarkShadowBorder" CornerRadius="10"
                                Background="{DynamicResource NeuroBackgroundBrush}"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="5" Direction="135"
                                                  Color="#1E1E2C" Opacity="0.9"/>
                            </Border.Effect>
                        </Border>
                        <Border x:Name="ContentBorder" CornerRadius="10"
                                Background="{DynamicResource NeuroBackgroundBrush}"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Ellipse x:Name="check" Width="8" Height="8"
                                         Fill="{DynamicResource NeuroAccentBrush}"
                                         Margin="0,0,8,0" Visibility="Collapsed"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="ContentBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="0" Direction="0"
                                                      Color="#A78BFA" Opacity="0.4"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="{DynamicResource NeuroAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource NeuroAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         应用卡片
         ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="NeuroAppCard" TargetType="Button">
        <Setter Property="Margin" Value="8"/>
        <Setter Property="MinWidth" Value="200"/>
        <Setter Property="MinHeight" Value="70"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="Background" Value="{DynamicResource NeuroBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource NeuroTextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="LightShadowBorder" CornerRadius="16"
                                Background="{DynamicResource NeuroBackgroundBrush}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="6" Direction="315"
                                                  Color="#3E3E52" Opacity="0.75"/>
                            </Border.Effect>
                        </Border>
                        <Border x:Name="DarkShadowBorder" CornerRadius="16"
                                Background="{DynamicResource NeuroBackgroundBrush}"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="6" Direction="135"
                                                  Color="#1E1E2C" Opacity="0.9"/>
                            </Border.Effect>
                        </Border>
                        <Border x:Name="ContentBorder" CornerRadius="16"
                                Background="{DynamicResource NeuroBackgroundBrush}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="LightShadowBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="8" Direction="315"
                                                      Color="#3E3E52" Opacity="0.85"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="DarkShadowBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="8" Direction="135"
                                                      Color="#1E1E2C" Opacity="0.95"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="{DynamicResource NeuroAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="LightShadowBorder" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="DarkShadowBorder" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="ContentBorder" Property="Background"
                                    Value="{DynamicResource NeuroInsetBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
