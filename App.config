<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    应用配置文件。

    【用法说明】
    - RemoteConfigUrl：远程配置服务端点（供 RemoteConfigService 启动时拉取 config.json）。
      不填时走代码默认值 http://www.ujuji.cn/hub/api/config.json。
    - LicenseServerUrl：注册/验证服务器地址。
      不填时走代码默认值 http://localhost:5232。
    - AppMarketUrl：应用市场首页地址。
      不填时走代码兜底值 http://localhost:8888/（实际地址由远程 config.json 提供）。
      优先级：RemoteConfig.marketServer > 环境变量 > 本项 > 兜底。

    【示例：指向本地开发服务器】
    <add key="RemoteConfigUrl"   value="http://localhost:8080/hub/api/config.json"/>
    <add key="LicenseServerUrl"  value="http://localhost:5232/"/>
    <add key="AppMarketUrl"     value="http://localhost:8888/"/>
  -->
  <appSettings>
    <!-- 远程配置服务端点（可选） -->
    <add key="RemoteConfigUrl" value="http://www.ujuji.cn/hub/api/config.json"/>

    <!-- 注册/验证服务器地址（可选） -->
    <!--<add key="LicenseServerUrl" value="http://82.157.32.44:5232/"/>-->

    <!-- 应用市场首页地址（可选） -->
    <!--<add key="AppMarketUrl" value="http://82.157.32.44:8888/"/>-->
  </appSettings>
</configuration>
