<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    仓库级 NuGet 源配置。
    当 dotnet restore 在 AiHUD 目录下执行时，会优先使用本文件声明的源，
    与全局 nuget.Config 合并。RegisterSrv.ClientSDK 已发布到 nuget.org，
    直接走公开源即可。
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
