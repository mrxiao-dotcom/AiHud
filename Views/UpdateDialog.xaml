<Window x:Class="AiDaBenYing.Views.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="发现新版本" Height="520" Width="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FF1E1E1E"
        TextElement.Foreground="#FFEEEEEE"
        TextElement.FontFamily="Microsoft YaHei UI">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFEEEEEE"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <materialDesign:PackIcon Kind="Update" Width="32" Height="32"
                                     Foreground="#FFFFB300"
                                     VerticalAlignment="Center" Margin="0,0,12,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="发现新版本" FontSize="22" FontWeight="Bold"/>
                <TextBlock x:Name="TxtVersionInfo" FontSize="13" Opacity="0.75"/>
            </StackPanel>
        </StackPanel>

        <!-- 是否强制更新 -->
        <Border Grid.Row="1" x:Name="ForcePanel"
                Background="#33FF6E40" CornerRadius="6" Padding="12,8" Margin="0,0,0,12"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="Alert" Foreground="#FFFF6E40"
                                         Width="20" Height="20"
                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="本次为强制更新，必须升级后才能继续使用。"
                           Foreground="#FFFFB29E" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 元数据 -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="新版本号：" Opacity="0.7"/>
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtNewVersion" FontWeight="Bold"/>

            <TextBlock Grid.Row="0" Grid.Column="2" Text="发布日期：" Opacity="0.7" Margin="16,0,0,0"/>
            <TextBlock Grid.Row="0" Grid.Column="3" x:Name="TxtReleaseDate"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="包大小：" Opacity="0.7" Margin="0,8,0,0"/>
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtFileSize" Margin="0,8,0,0"/>
        </Grid>

        <!-- 更新说明 -->
        <Border Grid.Row="3" Background="#FF2A2A2A" CornerRadius="6">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#FF333333" Padding="12,6">
                    <TextBlock Text="更新说明" FontWeight="Bold"/>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <TextBlock x:Name="TxtDescription" TextWrapping="Wrap" LineHeight="22"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- 进度区 -->
        <StackPanel Grid.Row="4" x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,12,0,0">
            <TextBlock x:Name="TxtProgress" Margin="0,0,0,6"/>
            <ProgressBar x:Name="ProgressBar" Height="10" Minimum="0" Maximum="100"/>
        </StackPanel>

        <!-- 按钮 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnLater" Content="稍后提醒"
                    Margin="0,0,8,0" Padding="16,6" Click="BtnLater_Click"/>
            <Button x:Name="BtnUpdate" Content="立即更新"
                    Padding="16,6" Click="BtnUpdate_Click"/>
        </StackPanel>
    </Grid>
</Window>
