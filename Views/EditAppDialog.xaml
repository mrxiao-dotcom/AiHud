<UserControl x:Class="AiHUD.Views.EditAppDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Width="450">

    <StackPanel Margin="24">
        <TextBlock Text="编辑应用信息" 
                   FontSize="20" 
                   FontWeight="Bold"
                   Margin="0,0,0,24"/>

        <!-- App Name -->
        <TextBox x:Name="AppNameTextBox"
                 materialDesign:HintAssist.Hint="应用名称"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 Margin="0,0,0,16"/>

        <!-- Executable Path -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="ExecutablePathTextBox"
                     Grid.Column="0"
                     materialDesign:HintAssist.Hint="可执行文件路径"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
            <Button Grid.Column="1"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Margin="8,0,0,0"
                    Click="BrowseExecutable_Click"
                    ToolTip="浏览...">
                <materialDesign:PackIcon Kind="FolderOpen"/>
            </Button>
        </Grid>

        <!-- Arguments -->
        <TextBox x:Name="ArgumentsTextBox"
                 materialDesign:HintAssist.Hint="启动参数（可选）"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 Margin="0,0,0,16"/>

        <!-- Description -->
        <TextBox x:Name="DescriptionTextBox"
                 materialDesign:HintAssist.Hint="描述（可选）"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 Height="80"
                 VerticalContentAlignment="Top"
                 Margin="0,0,0,16"/>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource MaterialDesignFlatButton}"
                    Content="取消"
                    Margin="0,0,8,0"
                    Click="Cancel_Click"/>
            <Button Style="{StaticResource MaterialDesignRaisedButton}"
                    Content="保存"
                    Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</UserControl>
