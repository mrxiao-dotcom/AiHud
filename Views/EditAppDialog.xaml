<UserControl x:Class="AiDaBenYing.Views.EditAppDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Width="470"
             Background="#2A2A38">

    <Border CornerRadius="20"
            Background="#2A2A38"
            Margin="4">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="8" Direction="315"
                              Color="#3A3A4C" Opacity="0.6"/>
        </Border.Effect>

        <StackPanel Margin="28,28,28,28">
            <!-- 标题 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <Border Width="44" Height="44" CornerRadius="12"
                        Background="#06B6D4">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="4" Direction="315"
                                          Color="#3A3A4C" Opacity="0.6"/>
                    </Border.Effect>
                    <materialDesign:PackIcon Kind="PencilCircle"
                                             Width="26" Height="26"
                                             Foreground="White"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="编辑应用信息"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#C4C4D4"
                           VerticalAlignment="Center"
                           Margin="14,0,0,0"/>
            </StackPanel>

            <!-- 应用名称（Neumorphic 凹陷） -->
            <Grid Margin="0,0,0,16">
                <Border CornerRadius="12" Background="#222230">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="4" Direction="135"
                                          Color="#1E1E28" Opacity="0.65"/>
                    </Border.Effect>
                </Border>
                <Border CornerRadius="12" BorderBrush="#3A3A4C" BorderThickness="1" Opacity="0.3"/>
                <TextBox x:Name="AppNameTextBox"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="#C4C4D4"
                         CaretBrush="#8B5CF6"
                         FontSize="14"
                         Padding="16,14"
                         VerticalContentAlignment="Center"
                         materialDesign:HintAssist.Hint="应用名称"
                         materialDesign:HintAssist.Foreground="#8888A0"
                         materialDesign:TextFieldAssist.DecorationVisibility="Hidden"/>
            </Grid>

            <!-- 可执行文件路径（Neumorphic 凹陷） -->
            <Grid Margin="0,0,0,16">
                <Border CornerRadius="12" Background="#222230">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="4" Direction="135"
                                          Color="#1E1E28" Opacity="0.65"/>
                    </Border.Effect>
                </Border>
                <Border CornerRadius="12" BorderBrush="#3A3A4C" BorderThickness="1" Opacity="0.3"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ExecutablePathTextBox"
                             Grid.Column="0"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#C4C4D4"
                             CaretBrush="#8B5CF6"
                             FontSize="14"
                             Padding="16,14"
                             VerticalContentAlignment="Center"
                             materialDesign:HintAssist.Hint="可执行文件路径"
                             materialDesign:HintAssist.Foreground="#8888A0"
                             materialDesign:TextFieldAssist.DecorationVisibility="Hidden"/>
                    <Button Grid.Column="1"
                            Style="{StaticResource NeuroIconButton}"
                            Margin="0,0,6,0"
                            Click="BrowseExecutable_Click"
                            ToolTip="浏览..."
                            Width="38" Height="38">
                        <materialDesign:PackIcon Kind="FolderOpen"
                                                 Width="18" Height="18"
                                                 Foreground="{StaticResource NeuroAccent2Brush}"/>
                    </Button>
                </Grid>
            </Grid>

            <!-- 启动参数（Neumorphic 凹陷） -->
            <Grid Margin="0,0,0,16">
                <Border CornerRadius="12" Background="#222230">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="4" Direction="135"
                                          Color="#1E1E28" Opacity="0.65"/>
                    </Border.Effect>
                </Border>
                <Border CornerRadius="12" BorderBrush="#3A3A4C" BorderThickness="1" Opacity="0.3"/>
                <TextBox x:Name="ArgumentsTextBox"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="#C4C4D4"
                         CaretBrush="#8B5CF6"
                         FontSize="14"
                         Padding="16,14"
                         VerticalContentAlignment="Center"
                         materialDesign:HintAssist.Hint="启动参数（可选）"
                         materialDesign:HintAssist.Foreground="#8888A0"
                         materialDesign:TextFieldAssist.DecorationVisibility="Hidden"/>
            </Grid>

            <!-- 描述（Neumorphic 凹陷，多行） -->
            <Grid Margin="0,0,0,24">
                <Border CornerRadius="12" Background="#222230">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="4" Direction="135"
                                          Color="#1E1E28" Opacity="0.65"/>
                    </Border.Effect>
                </Border>
                <Border CornerRadius="12" BorderBrush="#3A3A4C" BorderThickness="1" Opacity="0.3"/>
                <TextBox x:Name="DescriptionTextBox"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="#C4C4D4"
                         CaretBrush="#8B5CF6"
                         FontSize="14"
                         Padding="16,14"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="90"
                         VerticalContentAlignment="Top"
                         materialDesign:HintAssist.Hint="描述（可选）"
                         materialDesign:HintAssist.Foreground="#8888A0"
                         materialDesign:TextFieldAssist.DecorationVisibility="Hidden"/>
            </Grid>

            <!-- 按钮行 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource NeuroButton}"
                        Content="取消"
                        Foreground="#8888A0"
                        Padding="18,10"
                        Margin="0,0,10,0"
                        Click="Cancel_Click"/>
                <Button Style="{StaticResource NeuroPrimaryButton}"
                        Content="保存"
                        Foreground="#8B5CF6"
                        Padding="18,10"
                        Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
