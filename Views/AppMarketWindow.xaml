<Window x:Class="AiDaBenYing.Views.AppMarketWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="会员应用市场"
        Height="780" Width="1100"
        MinHeight="500" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="#FF1E1E1E"
        TextElement.Foreground="#FFEEEEEE"
        TextElement.FontFamily="Microsoft YaHei UI">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFEEEEEE"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部信息栏：只展示用途，不暴露 URL -->
        <Border Grid.Row="0"
                Background="#FF2A2A2A"
                Padding="20,14"
                BorderBrush="#FF333333"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Store"
                                             Width="28" Height="28"
                                             Foreground="#FF7C4DFF"
                                             VerticalAlignment="Center"
                                             Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="会员应用市场"
                                   FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="由服务端维护的应用列表，点开直接浏览与下载"
                                   FontSize="12" Opacity="0.7" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- 右侧：刷新 / 后退 / 关闭，不显示 URL 输入框 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnBack"
                            ToolTip="后退"
                            Margin="0,0,6,0"
                            Click="BtnBack_Click"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Padding="10,4">
                        <materialDesign:PackIcon Kind="ArrowLeft" Width="18" Height="18"/>
                    </Button>
                    <Button x:Name="BtnForward"
                            ToolTip="前进"
                            Margin="0,0,6,0"
                            Click="BtnForward_Click"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Padding="10,4">
                        <materialDesign:PackIcon Kind="ArrowRight" Width="18" Height="18"/>
                    </Button>
                    <Button x:Name="BtnRefresh"
                            ToolTip="刷新"
                            Margin="0,0,12,0"
                            Click="BtnRefresh_Click"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Padding="10,4">
                        <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18"/>
                    </Button>
                    <Button x:Name="BtnClose"
                            Content="关闭"
                            Padding="16,6"
                            Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- WebView2 主体：占满剩余空间，不预设 Source，避免与 EnsureCoreWebView2Async 竞态 -->
        <wv2:WebView2 x:Name="WebView"
                      Grid.Row="1"/>

        <!-- 底部状态栏：隐藏 URL，只显示当前加载状态 -->
        <Border Grid.Row="2"
                Background="#FF2A2A2A"
                Padding="20,8"
                BorderBrush="#FF333333"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon x:Name="StatusIcon"
                                             Kind="CloudOutline"
                                             Width="16" Height="16"
                                             VerticalAlignment="Center"
                                             Foreground="#FF66BB6A"
                                             Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtStatus"
                               Text="正在加载…"
                               VerticalAlignment="Center"
                               FontSize="12" Opacity="0.85"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="浏览应用列表，点击文件名旁的「下载」即可"
                           FontSize="12" Opacity="0.6"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
