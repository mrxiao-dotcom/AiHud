<Window x:Class="AiDaBenYing.Views.AppMarketWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="会员应用市场"
        Height="780" Width="1100"
        MinHeight="500" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource NeuroBackgroundBrush}"
        Foreground="{DynamicResource NeuroTextBrush}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════
             顶部标题栏（Neumorphic 凸起面板）
             ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Margin="16,16,16,0"
                CornerRadius="16"
                Background="{DynamicResource NeuroBackgroundBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="6" Direction="315"
                                  Color="{DynamicResource NeuroLightShadow}" Opacity="0.6"/>
            </Border.Effect>
            <Grid Margin="20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：标题 + 描述 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="48" Height="48"
                            CornerRadius="14"
                            Background="{DynamicResource NeuroAccentBrush}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="5" Direction="315"
                                              Color="{DynamicResource NeuroLightShadow}" Opacity="0.6"/>
                        </Border.Effect>
                        <materialDesign:PackIcon Kind="Store"
                                                 Width="28" Height="28"
                                                 Foreground="White"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="会员应用市场"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource NeuroTextBrush}"/>
                        <TextBlock Text="由服务端维护的应用列表，点开直接浏览与下载"
                                   FontSize="12"
                                   Foreground="{DynamicResource NeuroTextDimBrush}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- 右侧：导航按钮 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnBack"
                            ToolTip="后退"
                            Style="{DynamicResource NeuroIconButton}"
                            Margin="0,0,8,0"
                            Click="BtnBack_Click"
                            Width="40" Height="40">
                        <materialDesign:PackIcon Kind="ArrowLeft" Width="18" Height="18"
                                                 Foreground="{DynamicResource NeuroTextBrush}"/>
                    </Button>
                    <Button x:Name="BtnForward"
                            ToolTip="前进"
                            Style="{DynamicResource NeuroIconButton}"
                            Margin="0,0,8,0"
                            Click="BtnForward_Click"
                            Width="40" Height="40">
                        <materialDesign:PackIcon Kind="ArrowRight" Width="18" Height="18"
                                                 Foreground="{DynamicResource NeuroTextBrush}"/>
                    </Button>
                    <Button x:Name="BtnRefresh"
                            ToolTip="刷新"
                            Style="{DynamicResource NeuroIconButton}"
                            Margin="0,0,8,0"
                            Click="BtnRefresh_Click"
                            Width="40" Height="40">
                        <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18"
                                                 Foreground="{DynamicResource NeuroTextBrush}"/>
                    </Button>
                    <Button x:Name="BtnRetry"
                            ToolTip="WebView2 装好后点这里重新检测"
                            Style="{DynamicResource NeuroIconButton}"
                            Margin="0,0,14,0"
                            Click="BtnRetry_Click"
                            Width="40" Height="40">
                        <materialDesign:PackIcon Kind="RestartAlert" Width="18" Height="18"
                                                 Foreground="{DynamicResource NeuroTextBrush}"/>
                    </Button>
                    <Button x:Name="BtnClose"
                            Style="{DynamicResource NeuroButton}"
                            Content="关闭"
                            Foreground="{DynamicResource NeuroTextDimBrush}"
                            Padding="16,8"
                            Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════
             WebView2 主体（Neumorphic 凹陷容器）
             ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Margin="16,14"
                CornerRadius="16"
                Background="{DynamicResource NeuroInsetBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="6" Direction="135"
                                  Color="{DynamicResource NeuroDarkShadow}" Opacity="0.65"/>
            </Border.Effect>
            <!-- 内边框（模拟内壁） -->
            <Border CornerRadius="16"
                    BorderBrush="{DynamicResource NeuroBorderBrush}"
                    BorderThickness="1"
                    Opacity="0.3"
                    ClipToBounds="True">
                <wv2:WebView2 x:Name="WebView"/>
            </Border>
        </Border>

        <!-- ══════════════════════════════════════════════════════════
             底部状态栏（Neumorphic 凸起面板）
             ══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Margin="16,0,16,16"
                CornerRadius="12"
                Background="{DynamicResource NeuroBackgroundBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="5" Direction="315"
                                  Color="{DynamicResource NeuroLightShadow}" Opacity="0.5"/>
            </Border.Effect>
            <Grid Margin="18,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon x:Name="StatusIcon"
                                             Kind="CloudCheck"
                                             Width="16" Height="16"
                                             VerticalAlignment="Center"
                                             Foreground="{DynamicResource NeuroSuccessBrush}"
                                             Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtStatus"
                               Text="正在加载…"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource NeuroTextDimBrush}"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="浏览应用列表，点击文件名旁的「下载」即可"
                           FontSize="12"
                           Foreground="{DynamicResource NeuroTextDimBrush}"
                           VerticalAlignment="Center"
                           Opacity="0.7"/>
            </Grid>
        </Border>
    </Grid>
</Window>
