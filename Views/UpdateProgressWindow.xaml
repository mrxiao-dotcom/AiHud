<Window x:Class="AiDaBenYing.Views.UpdateProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="正在升级…"
        Height="320" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Background="{DynamicResource NeuroBackgroundBrush}"
        Foreground="{DynamicResource NeuroTextBrush}"
        TextElement.Foreground="{DynamicResource NeuroTextBrush}"
        FontFamily="Segoe UI">

    <Border CornerRadius="20" Margin="6"
            Background="{DynamicResource NeuroBackgroundBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="10" Direction="315"
                              Color="{DynamicResource NeuroLightShadow}" Opacity="0.6"/>
        </Border.Effect>

        <Grid Margin="28,24,28,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题行 -->
            <StackPanel Orientation="Horizontal">
                <Border Width="44" Height="44" CornerRadius="12"
                        Background="{DynamicResource NeuroAccentBrush}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="5" Direction="315"
                                          Color="{DynamicResource NeuroLightShadow}" Opacity="0.6"/>
                    </Border.Effect>
                    <materialDesign:PackIcon Kind="Update"
                                             Width="26" Height="26"
                                             Foreground="White"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock x:Name="TxtStage"
                               Text="正在准备升级…"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource NeuroTextBrush}"/>
                    <TextBlock x:Name="TxtVersion"
                               FontSize="12"
                               Foreground="{DynamicResource NeuroTextDimBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- 进度条 -->
            <Border Grid.Row="1" Margin="0,20,0,0"
                    CornerRadius="8" Height="14"
                    Background="{DynamicResource NeuroInsetBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="2" Direction="135"
                                      Color="{DynamicResource NeuroDarkShadow}" Opacity="0.5"/>
                </Border.Effect>
                <Border x:Name="ProgressFill"
                        CornerRadius="8"
                        HorizontalAlignment="Left"
                        Width="0"
                        Background="{DynamicResource NeuroAccentBrush}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="0"
                                          Color="{DynamicResource NeuroAccent}" Opacity="0.6"/>
                    </Border.Effect>
                </Border>
            </Border>

            <!-- 状态文字 -->
            <TextBlock Grid.Row="2"
                       x:Name="TxtProgress"
                       VerticalAlignment="Center"
                       Margin="0,8,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource NeuroTextDimBrush}"
                       TextWrapping="Wrap"/>

            <!-- 日志区域（只读滚动文本框） -->
            <Border Grid.Row="3" Margin="0,10,0,0"
                    CornerRadius="8"
                    Background="{DynamicResource NeuroInsetBrush}"
                    BorderBrush="{DynamicResource NeuroBorderBrush}"
                    BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="10,6">
                    <TextBlock x:Name="TxtLog"
                               FontFamily="Consolas"
                               FontSize="10"
                               Foreground="{DynamicResource NeuroTextDimBrush}"
                               TextWrapping="Wrap"
                               Text=""/>
                </ScrollViewer>
            </Border>

            <!-- 底部倒计时 + 提示 -->
            <Grid Grid.Row="4" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="TimerOutline"
                                             Width="14" Height="14"
                                             Foreground="{DynamicResource NeuroTextDimBrush}"
                                             VerticalAlignment="Center"/>
                    <TextBlock Text=" 预计还需 "
                               FontSize="11"
                               Foreground="{DynamicResource NeuroTextDimBrush}"
                               VerticalAlignment="Center"
                               Margin="4,0,0,0"/>
                    <TextBlock x:Name="TxtCountdown"
                               Text="--"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource NeuroAccentBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text=" 秒"
                               FontSize="11"
                               Foreground="{DynamicResource NeuroTextDimBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="请勿关闭此窗口…"
                           FontSize="11"
                           Foreground="{DynamicResource NeuroTextDimBrush}"
                           VerticalAlignment="Center"
                           Opacity="0.8"/>
            </Grid>
        </Grid>
    </Border>
</Window>
