<Window x:Class="AiHUD.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewmodels="clr-namespace:AiHUD.ViewModels"
        xmlns:converters="clr-namespace:AiHUD.Converters"
        mc:Ignorable="d"
        Title="AI Hub - AI工具管理器"
        Height="800" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
        Background="{DynamicResource MaterialDesign.Brush.Background}"
        TextElement.FontWeight="Medium"
        TextElement.FontSize="14"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:StringToColorBrushConverter x:Key="StringToColorBrushConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <converters:EqualityConverter x:Key="EqualityConverter"/>
        <converters:MoveAppConverter x:Key="MoveAppConverter"/>
        <converters:StringToInitialsConverter x:Key="StringToInitialsConverter"/>

        <!-- Category Item Style with Highlight -->
        <Style x:Key="CategoryItemStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource EqualityConverter}">
                            <Binding/>
                            <Binding Path="DataContext.SelectedCategory" RelativeSource="{RelativeSource AncestorType=Window}"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary.Light}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- All Apps Button Style with Highlight -->
        <Style x:Key="AllAppsButtonStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedCategory}" Value="{x:Null}">
                    <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary.Light}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- App Card Template -->
        <DataTemplate x:Key="AppCardTemplate">
            <Button Margin="8"
                    MinWidth="200"
                    MinHeight="60"
                    Padding="16,12"
                    HorizontalContentAlignment="Stretch"
                    Command="{Binding DataContext.LaunchAppCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    PreviewMouseRightButtonUp="AppButton_PreviewMouseRightButtonUp">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="编辑"
                                  Click="EditApp_Click">
                            <MenuItem.Icon>
                                <materialDesign:PackIcon Kind="Pencil"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="在文件资源管理器中显示"
                                  Click="OpenInExplorer_Click">
                            <MenuItem.Icon>
                                <materialDesign:PackIcon Kind="FolderOpen"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="移动到..."
                                  Click="MoveApp_Click">
                            <MenuItem.Icon>
                                <materialDesign:PackIcon Kind="FolderMove"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="删除"
                                  Click="DeleteApp_Click">
                            <MenuItem.Icon>
                                <materialDesign:PackIcon Kind="Delete" Foreground="Red"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Button.ContextMenu>
                <TextBlock Text="{Binding Name}" FontSize="16"/>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <materialDesign:DialogHost Identifier="RootDialog">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar -->
            <Border Grid.Column="0"
                    Background="{DynamicResource MaterialDesign.Brush.Background}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Margin="16,20,16,8">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Robot"
                                                     Width="36" Height="36"
                                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock Text="AI Hub"
                                           FontSize="24"
                                           FontWeight="Bold"/>
                                <TextBlock Text="AI工具管理器"
                                           FontSize="12"
                                           Opacity="0.7"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Search Box -->
                    <TextBox Grid.Row="1"
                             Margin="16,8,16,16"
                             materialDesign:HintAssist.Hint="搜索应用..."
                             materialDesign:TextFieldAssist.HasClearButton="True"
                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                             materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- Categories List -->
                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- All Apps Button -->
                            <Grid Margin="4,2" Cursor="Hand" MouseLeftButtonDown="AllApps_Click">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left accent bar -->
                                <Border x:Name="AllAppsAccentBar"
                                        Grid.Column="0"
                                        CornerRadius="1.5"
                                        Width="3"
                                        Background="Transparent">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedCategory}" Value="{x:Null}">
                                                    <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <!-- Button content -->
                                <Border Grid.Column="1"
                                        Padding="12,10"
                                        CornerRadius="0,8,8,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedCategory}" Value="{x:Null}">
                                                    <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary.Light}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <materialDesign:PackIcon Grid.Column="0"
                                                                 Kind="Apps"
                                                                 Width="24" Height="24"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="全部应用"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0"
                                                   FontSize="15"
                                                   FontWeight="Medium"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding AllApps.Count, StringFormat='({0})'}"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0"
                                                   Opacity="0.6"
                                                   FontSize="12"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Category Items -->
                            <ItemsControl x:Name="CategoriesPanel" ItemsSource="{Binding Categories}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,2" Cursor="Hand" MouseLeftButtonDown="CategoryItem_Click">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Left accent bar -->
                                            <Border Grid.Column="0"
                                                    CornerRadius="1.5"
                                                    Width="3"
                                                    Background="Transparent">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Value="True">
                                                                <DataTrigger.Binding>
                                                                    <MultiBinding Converter="{StaticResource EqualityConverter}">
                                                                        <Binding/>
                                                                        <Binding Path="DataContext.SelectedCategory" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                    </MultiBinding>
                                                                </DataTrigger.Binding>
                                                                <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <!-- Button content -->
                                            <Border Grid.Column="1"
                                                    Tag="{Binding}"
                                                    Padding="12,10"
                                                    CornerRadius="0,8,8,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Value="True">
                                                                <DataTrigger.Binding>
                                                                    <MultiBinding Converter="{StaticResource EqualityConverter}">
                                                                        <Binding/>
                                                                        <Binding Path="DataContext.SelectedCategory" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                                    </MultiBinding>
                                                                </DataTrigger.Binding>
                                                                <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary.Light}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <materialDesign:PackIcon Grid.Column="0"
                                                                             Kind="{Binding Icon}"
                                                                             Width="24" Height="24"
                                                                             VerticalAlignment="Center"
                                                                             Foreground="{Binding Color, Converter={StaticResource StringToColorBrushConverter}}"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Name}"
                                                               VerticalAlignment="Center"
                                                               Margin="12,0,0,0"
                                                               FontSize="15"
                                                               FontWeight="Medium"/>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding AppItems.Count, StringFormat='({0})'}"
                                                               VerticalAlignment="Center"
                                                               Margin="8,0,0,0"
                                                               Opacity="0.6"
                                                               FontSize="12"/>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Add Category Button -->
                            <Button Margin="16,8"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Click="AddCategory_Click">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" Margin="0,0,8,0"/>
                                    <TextBlock Text="添加分类"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom Actions -->
                    <StackPanel Grid.Row="3" Margin="16,8,16,16">
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                HorizontalAlignment="Left"
                                Command="{Binding ToggleThemeCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ThemeLightDark"/>
                                <TextBlock Text="切换主题" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Divider -->
            <Rectangle Grid.Column="0"
                       HorizontalAlignment="Right"
                       Width="1"
                       Fill="{DynamicResource MaterialDesign.Brush.ForegroundLight}"/>

            <!-- Main Content Area -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top Bar -->
                <Border Grid.Row="0"
                        Padding="24,16"
                        Background="{DynamicResource MaterialDesign.Brush.Background}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Category Title -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="{Binding CurrentCategoryIcon}"
                                                     Width="32" Height="32"
                                                     VerticalAlignment="Center"
                                                     Foreground="{Binding CurrentCategoryColor, Converter={StaticResource StringToColorBrushConverter}}"/>
                            <TextBlock Text="{Binding CurrentCategoryName}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0"/>
                        </StackPanel>

                        <!-- Action Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                    Margin="0,0,8,0"
                                    Command="{Binding AddAppCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" Margin="0,0,8,0"/>
                                    <TextBlock Text="添加应用"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Command="{Binding AddAppManuallyCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="PencilPlus" Margin="0,0,8,0"/>
                                    <TextBlock Text="手动添加"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Apps List -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding FilteredApps}"
                                  ItemTemplate="{StaticResource AppCardTemplate}"
                                  Margin="16,0,16,16">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Empty State -->
                <StackPanel Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding HasNoApps, Converter={StaticResource BoolToVisibilityConverter}}">
                    <materialDesign:PackIcon Kind="Apps"
                                             Width="80" Height="80"
                                             HorizontalAlignment="Center"
                                             Opacity="0.3"/>
                    <TextBlock Text="还没有添加任何应用"
                               FontSize="18"
                               Opacity="0.5"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,8"/>
                    <TextBlock Text="点击上方「添加应用」按钮开始添加"
                               FontSize="14"
                               Opacity="0.3"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Loading Overlay -->
            <Border Grid.ColumnSpan="2"
                    Background="#80000000"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                 IsIndeterminate="True"
                                 Width="60" Height="60"/>
                    <TextBlock Text="加载中..."
                               Margin="0,16,0,0"
                               FontSize="16"/>
                </StackPanel>
            </Border>
        </Grid>
    </materialDesign:DialogHost>
</Window>
