<Window x:Class="AiDaBenYing.Views.WebView2MissingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="需要安装 WebView2 运行时"
        Height="460" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource NeuroBackgroundBrush}"
        Foreground="{DynamicResource NeuroTextBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource NeuroTextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题区 -->
        <Border Grid.Row="0"
                Margin="0,0,0,18"
                CornerRadius="16"
                Background="{DynamicResource NeuroBackgroundBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="6" Direction="315"
                                  Color="{DynamicResource NeuroLightShadow}" Opacity="0.6"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" Margin="4">
                <Border Width="52" Height="52" CornerRadius="14"
                        Background="{DynamicResource NeuroWarningBrush}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="5" Direction="315"
                                          Color="{DynamicResource NeuroLightShadow}" Opacity="0.6"/>
                    </Border.Effect>
                    <materialDesign:PackIcon Kind="AlertCircleOutline"
                                             Width="30" Height="30"
                                             Foreground="White"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="未检测到 WebView2 运行时" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource NeuroTextBrush}"/>
                    <TextBlock Text="应用市场需要 Microsoft Edge WebView2 Runtime 才能打开"
                               FontSize="12"
                               Foreground="{DynamicResource NeuroTextDimBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 操作选项区 -->
        <Border Grid.Row="1" CornerRadius="12" Padding="18,16"
                Background="{DynamicResource NeuroInsetBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="4" Direction="135"
                                  Color="{DynamicResource NeuroDarkShadow}" Opacity="0.65"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="请选择以下任一方式安装（推荐 Evergreen，自动更新）"
                           FontSize="13" Margin="0,0,0,14"
                           Foreground="{DynamicResource NeuroTextDimBrush}"/>

                <Button x:Name="BtnDownload"
                        Style="{DynamicResource NeuroPrimaryButton}"
                        HorizontalContentAlignment="Left"
                        Padding="16,12" Margin="0,0,0,10"
                        Click="BtnDownload_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Web" Width="20" Height="20"
                                                 VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel>
                            <TextBlock Text="打开微软官方下载页（推荐）" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource NeuroAccentBrush}"/>
                            <TextBlock Text="自动下载 Evergreen Standalone Installer，双击安装即可"
                                       FontSize="11" Margin="0,2,0,0"
                                       Foreground="{DynamicResource NeuroTextDimBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnOpenLocal"
                        Style="{DynamicResource NeuroButton}"
                        HorizontalContentAlignment="Left"
                        Padding="16,12" Margin="0,0,0,10"
                        Click="BtnOpenLocal_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FolderOpen" Width="20" Height="20"
                                                 VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel>
                            <TextBlock Text="选择本地安装包" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="若已下载 MicrosoftEdgeWebview2Setup.exe，可直接安装"
                                       FontSize="11" Margin="0,2,0,0"
                                       Foreground="{DynamicResource NeuroTextDimBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Button x:Name="BtnRetry"
                        Style="{DynamicResource NeuroButton}"
                        HorizontalContentAlignment="Left"
                        Padding="16,12"
                        Click="BtnRetry_Click">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20"
                                                 VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel>
                            <TextBlock Text="装好了，重新检测" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="安装完成后点这里；如果已经装了 Win11/最新 Edge 也可以"
                                       FontSize="11" Margin="0,2,0,0"
                                       Foreground="{DynamicResource NeuroTextDimBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <TextBlock x:Name="TxtLog" Margin="0,14,0,0" FontSize="11"
                           Foreground="{DynamicResource NeuroTextDimBrush}"
                           TextWrapping="Wrap" Text=""/>
            </StackPanel>
        </Border>

        <!-- 关闭按钮 -->
        <Button Grid.Row="2"
                Style="{DynamicResource NeuroButton}"
                Content="关闭"
                Foreground="{DynamicResource NeuroTextDimBrush}"
                Padding="22,10"
                Margin="0,18,0,0"
                HorizontalAlignment="Right"
                Click="BtnCancel_Click"/>
    </Grid>
</Window>
