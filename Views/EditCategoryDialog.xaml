<UserControl x:Class="AiDaBenYing.Views.EditCategoryDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:AiDaBenYing.Converters"
             Width="400">

    <UserControl.Resources>
        <converters:StringToColorBrushConverter x:Key="StringToColorBrushConverter"/>
    </UserControl.Resources>

    <StackPanel Margin="24">
        <TextBlock Text="编辑分类"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,24"/>

        <!-- Category Name -->
        <TextBox x:Name="CategoryNameTextBox"
                 materialDesign:HintAssist.Hint="分类名称"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 Margin="0,0,0,16"/>

        <!-- Color Picker -->
        <TextBlock Text="选择颜色"
                   FontSize="14"
                   Margin="0,0,0,8"/>
        <WrapPanel Margin="0,0,0,16">
            <RadioButton x:Name="ColorPurple" GroupName="CategoryColor"
                         Style="{StaticResource MaterialDesignChoiceChipPrimaryRadioButton}"
                         Content="紫色" Background="#7C4DFF"/>
            <RadioButton x:Name="ColorGreen" GroupName="CategoryColor"
                         Style="{StaticResource MaterialDesignChoiceChipPrimaryRadioButton}"
                         Content="绿色" Background="#4CAF50"/>
            <RadioButton x:Name="ColorBlue" GroupName="CategoryColor"
                         Style="{StaticResource MaterialDesignChoiceChipPrimaryRadioButton}"
                         Content="蓝色" Background="#2196F3"/>
            <RadioButton x:Name="ColorOrange" GroupName="CategoryColor"
                         Style="{StaticResource MaterialDesignChoiceChipPrimaryRadioButton}"
                         Content="橙色" Background="#FF9800"/>
            <RadioButton x:Name="ColorRed" GroupName="CategoryColor"
                         Style="{StaticResource MaterialDesignChoiceChipPrimaryRadioButton}"
                         Content="红色" Background="#F44336"/>
            <RadioButton x:Name="ColorPink" GroupName="CategoryColor"
                         Style="{StaticResource MaterialDesignChoiceChipPrimaryRadioButton}"
                         Content="粉色" Background="#E91E63"/>
        </WrapPanel>

        <!-- Icon Picker -->
        <TextBlock Text="选择图标"
                   FontSize="14"
                   Margin="0,0,0,8"/>
        <WrapPanel Margin="0,0,0,24">
            <RadioButton x:Name="IconFolder" GroupName="CategoryIcon"
                         Style="{StaticResource MaterialDesignChoiceChipPrimaryRadioButton}"
                         ToolTip="文件夹">
                <materialDesign:PackIcon Kind="FolderOutline"/>
            </RadioButton>
            <RadioButton x:Name="IconChart" GroupName="CategoryIcon"
                         Style="{StaticResource MaterialDesignChoiceChipPrimaryRadioButton}"
                         ToolTip="图表">
                <materialDesign:PackIcon Kind="ChartLine"/>
            </RadioButton>
            <RadioButton x:Name="IconRobot" GroupName="CategoryIcon"
                         Style="{StaticResource MaterialDesignChoiceChipPrimaryRadioButton}"
                         ToolTip="机器人">
                <materialDesign:PackIcon Kind="Robot"/>
            </RadioButton>
            <RadioButton x:Name="IconWrench" GroupName="CategoryIcon"
                         Style="{StaticResource MaterialDesignChoiceChipPrimaryRadioButton}"
                         ToolTip="工具">
                <materialDesign:PackIcon Kind="Wrench"/>
            </RadioButton>
            <RadioButton x:Name="IconCode" GroupName="CategoryIcon"
                         Style="{StaticResource MaterialDesignChoiceChipPrimaryRadioButton}"
                         ToolTip="代码">
                <materialDesign:PackIcon Kind="Code"/>
            </RadioButton>
            <RadioButton x:Name="IconBrain" GroupName="CategoryIcon"
                         Style="{StaticResource MaterialDesignChoiceChipPrimaryRadioButton}"
                         ToolTip="大脑">
                <materialDesign:PackIcon Kind="Brain"/>
            </RadioButton>
            <RadioButton x:Name="IconGamepad" GroupName="CategoryIcon"
                         Style="{StaticResource MaterialDesignChoiceChipPrimaryRadioButton}"
                         ToolTip="游戏">
                <materialDesign:PackIcon Kind="GamepadVariant"/>
            </RadioButton>
            <RadioButton x:Name="IconBook" GroupName="CategoryIcon"
                         Style="{StaticResource MaterialDesignChoiceChipPrimaryRadioButton}"
                         ToolTip="书籍">
                <materialDesign:PackIcon Kind="BookOpenPageVariant"/>
            </RadioButton>
        </WrapPanel>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource MaterialDesignFlatButton}"
                    Content="取消"
                    Margin="0,0,8,0"
                    Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                    CommandParameter="{x:Null}"/>
            <Button Style="{StaticResource MaterialDesignRaisedButton}"
                    Content="保存"
                    Click="SaveButton_Click"/>
        </StackPanel>
    </StackPanel>
</UserControl>
