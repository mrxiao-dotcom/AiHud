<UserControl x:Class="AiDaBenYing.Views.MoveAppDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:AiDaBenYing.Converters"
             Width="420"
             Background="{DynamicResource NeuroBackgroundBrush}">

    <UserControl.Resources>
        <converters:StringToColorBrushConverter x:Key="StringToColorBrushConverter"/>
    </UserControl.Resources>

    <Border CornerRadius="20"
            Background="{DynamicResource NeuroBackgroundBrush}"
            Margin="4">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="10" Direction="315"
                              Color="{DynamicResource NeuroLightShadow}" Opacity="0.6"/>
        </Border.Effect>

        <StackPanel Margin="28">
            <!-- 标题 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Border Width="44" Height="44" CornerRadius="12"
                        Background="{DynamicResource NeuroAccent2Brush}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="5" Direction="315"
                                          Color="{DynamicResource NeuroLightShadow}" Opacity="0.6"/>
                    </Border.Effect>
                    <materialDesign:PackIcon Kind="FolderMove"
                                             Width="26" Height="26"
                                             Foreground="White"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="移动应用到"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{DynamicResource NeuroTextBrush}"/>
                    <TextBlock x:Name="AppNameTextBlock"
                               FontSize="13"
                               Foreground="{DynamicResource NeuroTextDimBrush}"
                               Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- 分类列表（Neumorphic 凹陷容器） -->
            <Border CornerRadius="12"
                    Background="{DynamicResource NeuroInsetBrush}"
                    Margin="0,16,0,0"
                    MaxHeight="320">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="5" Direction="135"
                                      Color="{DynamicResource NeuroDarkShadow}" Opacity="0.65"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <ItemsControl x:Name="CategoriesItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{DynamicResource NeuroFlatButton}"
                                        HorizontalContentAlignment="Left"
                                        Margin="4,6"
                                        Padding="12,10"
                                        Click="Category_Click"
                                        Tag="{Binding}"
                                        Foreground="{DynamicResource NeuroTextBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="{Binding Icon}"
                                                                 Width="22" Height="22"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{Binding Color, Converter={StaticResource StringToColorBrushConverter}}"/>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="15"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- 取消按钮 -->
            <Button Style="{DynamicResource NeuroButton}"
                    Content="取消"
                    Foreground="{DynamicResource NeuroTextDimBrush}"
                    HorizontalAlignment="Left"
                    Margin="0,20,0,0"
                    Padding="18,10"
                    Click="Cancel_Click"/>
        </StackPanel>
    </Border>
</UserControl>
