<UserControl x:Class="AiDaBenYing.Views.MoveAppDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:AiDaBenYing.Converters"
             Width="420"
             Background="#2A2A38">

    <UserControl.Resources>
        <converters:StringToColorBrushConverter x:Key="StringToColorBrushConverter"/>
    </UserControl.Resources>

    <Border CornerRadius="20"
            Background="#2A2A38"
            Margin="4">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="8" Direction="315"
                              Color="#3A3A4C" Opacity="0.6"/>
        </Border.Effect>

        <StackPanel Margin="28,28,28,28">
            <!-- 标题 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Border Width="44" Height="44" CornerRadius="12"
                        Background="#06B6D4">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="4" Direction="315"
                                          Color="#3A3A4C" Opacity="0.6"/>
                    </Border.Effect>
                    <materialDesign:PackIcon Kind="FolderMove"
                                             Width="26" Height="26"
                                             Foreground="White"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="移动应用到"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#C4C4D4"/>
                    <TextBlock x:Name="AppNameTextBlock"
                               FontSize="13"
                               Foreground="#8888A0"
                               Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- 分类列表（Neumorphic 凹陷容器） -->
            <Border CornerRadius="12"
                    Background="#222230"
                    Margin="0,16,0,0"
                    MaxHeight="320">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="4" Direction="135"
                                      Color="#1E1E28" Opacity="0.65"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Padding="8,8">
                    <ItemsControl x:Name="CategoriesItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource NeuroFlatButton}"
                                        HorizontalContentAlignment="Left"
                                        Margin="4,6"
                                        Padding="12,10"
                                        Click="Category_Click"
                                        Tag="{Binding}"
                                        Foreground="#C4C4D4">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="36" Height="36"
                                                CornerRadius="10"
                                                Background="{Binding Color, Converter={StaticResource StringToColorBrushConverter}}"
                                                Opacity="0.25">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="6" ShadowDepth="3"
                                                                  Direction="315" Color="#3A3A4C" Opacity="0.4"/>
                                            </Border.Effect>
                                        </Border>
                                        <materialDesign:PackIcon Kind="{Binding Icon}"
                                                                 Width="22" Height="22"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{Binding Color, Converter={StaticResource StringToColorBrushConverter}}"
                                                                 Margin="0,0,0,0"/>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="15"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- 取消按钮 -->
            <Button Style="{StaticResource NeuroButton}"
                    Content="取消"
                    Foreground="#8888A0"
                    HorizontalAlignment="Left"
                    Margin="0,20,0,0"
                    Padding="18,10"
                    Click="Cancel_Click"/>
        </StackPanel>
    </Border>
</UserControl>
